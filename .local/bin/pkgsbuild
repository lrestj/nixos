#!/bin/bash

echo
echo "######################"
echo "#  Instalace vim     #"
echo "######################"
mkdir -p $HOME/.local/src
cd $HOME/.local/src
git clone --depth=222 https://github.com/vim/vim.git
cd vim/src
make
sudo make install

echo
echo "######################"
echo "#  Instalace fuzzel  #"
echo "######################"
sudo apt -y install \
    cmake meson ninja-build \
    wayland-protocols libwayland-dev \
    libfcft-dev libcairo2-dev \
    libpng-dev librsvg2-dev \
    libxkbcommon-dev scdoc \
    libtllist-dev

mkdir -p $HOME/.local/src
cd $HOME/.local/src
git clone https://gitlab.freedesktop.org/pixman/pixman.git
cd pixman
meson setup builddir --prefix=/usr/local
meson compile -C builddir
sudo meson install -C builddir

cd $HOME/.local/src
git clone https://codeberg.org/dnkl/fuzzel.git
cd fuzzel
mkdir -p build
cd build
meson setup --buildtype=release --prefix=/usr ..
ninja
sudo ninja install

echo
echo "###########################"
echo "#  Instalace xfce-polkit  #"
echo "###########################"
echo
sudo apt -y install ninja-build libxfce4ui-2-dev libpolkit-agent-1-dev
mkdir -p $HOME/.local/src/
cd $HOME/.local/src
git clone https://github.com/ncopa/xfce-polkit.git
cd xfce-polkit
mkdir build
cd build
meson setup --prefix=/usr ..
ninja
sudo ninja install

echo
echo "#####################"
echo "#  Konec instalace  #"
echo "#####################"
echo
echo "####################################"
echo "#  Restartovat do nového systému?  #"
echo "####################################"
while true; do
    read -r -n 1 -p "Vyberte (A/N): " answer
    case $answer in
        [Aa]* ) echo -e "\n Restartuji..."
                sleep 1
                sudo reboot; break;;
        [Nn]* ) exit;;
        * ) echo -e "\nVyberte A nebo N.";;
    esac
done

#  END OF FILLE  #

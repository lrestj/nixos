#!/bin/bash

echo "############################"
echo "#                          #"
echo "#  Spouštím instalaci...   #"
echo "#                          #"
echo "############################"
echo ".cfg.git" >> .gitignore &&

echo "################################"
echo "#                              #"
echo "#  Kopírování z repozitáře...  #"
echo "#                              #"
echo "################################"
git clone --bare https://github.com/lrestj/nixos.git $HOME/.cfg.git

echo "###########################"
echo "#                         #"
echo "#  Přesun konfigurace...  #"
echo "#                         #"
echo "###########################"
git --git-dir=$HOME/.cfg.git/ --work-tree=$HOME checkout -f &&

echo
echo "##################################"
echo "#  Na jaký počítač instalujete?  #"
echo "#  Zbook = 1                     #"
echo "#  Probook = 2                   #"
echo "#  Mirantb = 3                   #"
echo "##################################"

while true; do
    read -r -n 1 -p " Vyberte 1/2: " answer
    case $answer in
        [1]* ) echo
               echo "####################################"
               echo "#                                  #"
               echo "#  Probíhá konfigurace Zbook...    #"
               echo "#                                  #"
               echo "####################################"
               cp -fv /etc/nixos/hardware-configuration.nix /home/libor/.dotfiles/nixos/hosts/zbook/ 
               sudo nixos-rebuild switch --flake /home/libor/.dotfiles/nixos#nixos 
               break;;
        [2]* ) echo
               echo "######################################"
               echo "#                                    #"
               echo "#  Probíhá konfigurace Probook...    #"
               echo "#                                    #"
               echo "######################################"
               cp -fv /etc/nixos/hardware-configuration.nix /home/libor/.dotfiles/nixos/hosts/probook/ 
               sudo nixos-rebuild switch --flake /home/libor/.dotfiles/nixos#probook
               break;;
        [3]* ) echo
               echo "######################################"
               echo "#                                    #"
               echo "#  Probíhá konfigurace Mirantb...    #"
               echo "#                                    #"
               echo "######################################"
               cp -fv /etc/nixos/hardware-configuration.nix /home/libor/.dotfiles/nixos/hosts/mirantb/ 
               sudo nixos-rebuild switch --flake /home/libor/.dotfiles/nixos#mirantb
               break;;
         * ) echo "Vyberte 1, 2, nebo 3";;
     esac
done
  
echo
echo "###################################"
echo "#                                 #"
echo "#  Konfigurace git repozitáře...  #"
echo "#                                 #"
echo "###################################"
git config --global user.email "rest@seznam.cz"
git config --global user.name "LrestJ"
git --git-dir=/home/libor/.cfg.git/ --work-tree=/home/libor remote remove origin
git --git-dir=/home/libor/.cfg.git/ --work-tree=/home/libor remote add github git@github.com:lrestj/nixos.git
git --git-dir=/home/libor/.cfg.git/ --work-tree=/home/libor remote add gitlab git@gitlab.com:lrestj/nixos.git

echo -e "\n"
echo "############################"
echo "#                          #" 
echo "#  Konec instalace         #" 
echo "#  Lze smazat /etc/nixos/  #" 
echo "#                          #" 
echo "############################"

##### END OF FILE #####

#!/bin/bash

a=" Vimrc"
b="Niri conf"
c="Waybar config"
d="Mako config"
e="Wallpaper"
f="Stuff2remember"
g="Configuration.nix"
h="Flake.nix"
i="Pkgs"
j="Add new script"
k="Odpojit..."
l="Update vim"
ai="\0icon\x1fvim"
bi="\0icon\x1fniri"
ci="\0icon\x1fwayland"
di="\0icon\x1fnotion"
ei="\0icon\x1fdesktop-effects"
fi="\0icon\x1fnotepad"
gi="\0icon\x1fpreferences-system-services"
hi="\0icon\x1fpreferences-system-services"
ii="\0icon\x1fpreferences-system-services"
ji="\0icon\x1fadd"
ki="\0icon\x1funity-fallback-mount-helper"

selected=$(echo -e "\
1\t$b$bi\n\
2v\t$a$ai\n\
3y\t$e$ei\n\
4w\t$c$ci\n\
5m\t$d$di\n\
6s\t$f$fi\n\
7c\t$g$gi\n\
8f\t$h$hi\n\
9p\t$i$ii\n\
0a\t$j$ji\n\
u\t$l$ai\n\
o\t$k$ki\
" | fuzzel --match-nth 1 --with-nth 2 --accept-nth 2 --lines 18 --auto-select -d )

case $selected in
    "$a")
        foot --app-id vim bash -c "sleep 0.1; exec vim ~/.config/vim/vimrc";;
    "$b")
        foot --app-id vim bash -c "sleep 0.1; exec vim ~/.config/niri/config.kdl";;
    "$c")
        foot --app-id vim bash -c "sleep 0.1; exec vim ~/.config/waybar/config-niri.jsonc";;
    "$d")
        foot --app-id vim bash -c "sleep 0.1; exec vim ~/.config/mako/config";;
    "$e")
        waypaper;;
    "$f")
        foot --app-id vim bash -c "sleep 0.1; exec vim ~/.dotfiles/install/stuff2remember.txt";;
    "$g")
        $TERMINAL -e vim ~/.dotfiles/nixos/hosts/zbook/configuration.nix;;
    "$h")
        $TERMINAL -e vim ~/.dotfiles/nixos/flake.nix;;
    "$i")
        $TERMINAL -e vim ~/.dotfiles/nixos/modules/pkgs.nix;;
    "$j")
        addnew;;
    "$l")
        vupdnx;;
    "$k")
        fuzzel-umount
esac


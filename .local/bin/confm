#!/bin/bash

# Menu
a=" Vimrc"
b="Niri conf"
c="Waybar config"
d="Fish config"
e="Fastfetch"
f="Stuff2remember"
g="Add new script"
h="QuickMarks"
k="Odpojit..."

# Ikony
ai="\0icon\x1fvim"
bi="\0icon\x1fniri"
ci="\0icon\x1fwayland"
di="\0icon\x1ffish"
ei="\0icon\x1fdesktop-effects"
fi="\0icon\x1fnotepad"
gi="\0icon\x1ftext-x-script"
hi="\0icon\x1fbookmarks"
ki="\0icon\x1funity-fallback-mount-helper"


selected=$(echo -e "\
n\t$b$bi\n\
v\t$a$ai\n\
o\t$k$ki\n\
ff\t$e$ei\n\
w\t$c$ci\n\
fi\t$d$di\n\
s\t$f$fi\n\
a\t$g$gi\n\
q\t$h$hi\
" | fuzzel --lines 14 --with-nth 2 --accept-nth 2 --match-nth 1 --auto-select -d )

case $selected in
    "$a")
        foot --app-id vim bash -c "sleep 0.1; exec vim ~/.config/vim/vimrc";;
    "$b")
        foot --app-id vim bash -c "sleep 0.1; exec vim ~/.config/niri/config.kdl";;
    "$c")
        foot --app-id vim bash -c "sleep 0.1; exec vim ~/.config/waybar/config-niri.jsonc";;
    "$d")
        foot --app-id vim bash -c "sleep 0.1; exec vim ~/.config/fish/config.fish";;
    "$e")
        foot --app-id fastfetch bash -c "fastfetch; read";;
    "$f")
        foot --app-id vim bash -c "sleep 0.1; exec vim ~/.dotfiles/install/stuff2remember.txt";;
    "$g")
        addnew;;
    "$k")
        fuzzel-umount;;
    "$h")
        foot --app-id vim bash -c "sleep 0.1; exec vim ~/.config/qutebrowser/quickmarks";;
    *)
        notify-send "Nic k provedení";;
esac

#!/bin/bash

a=" vimxrc"
b="Niri conf"
c="Waybar config"
d="Mako config"
e="Plocha"
f="Stuff2remember"
g="Configuration.nix"
h="Flake.nix"
i="Pkgs"
j="Add new script"
k="Odpojit..."

ai="\0icon\x1fgvim"
bi="\0icon\x1fniri"
ci="\0icon\x1fwayland"
di="\0icon\x1fnotion"
ei="\0icon\x1fdesktop-effects"
fi="\0icon\x1fnotepad"
gi="\0icon\x1fpreferences-system-services"
hi="\0icon\x1fpreferences-system-services"
ii="\0icon\x1fpreferences-system-services"
ji="\0icon\x1fadd"
ki="\0icon\x1funity-fallback-mount-helper"

selected=$(echo -e "\
n\t$b$bi\n\
w\t$c$ci\n\
o\t$k$ki\n\
v\t$a$ai\n\
p\t$e$ei\n\
m\t$d$di\n\
s\t$f$fi\n\
a\t$j$ji\
" | fuzzel --with-nth 2 --accept-nth 2 --match-nth 1 --lines 8 --auto-select -d )

case $selected in
    "$a")
        foot --app-id vimx bash -c "sleep 0.1; exec $EDITOR ~/.config/vim/vimrc";;
    "$b")
        foot --app-id vimx bash -c "sleep 0.1; exec $EDITOR ~/.config/niri/config.kdl";;
    "$c")
        foot --app-id vimx bash -c "sleep 0.1; exec $EDITOR ~/.config/waybar/config.jsonc";;
    "$d")
        foot --app-id vimx bash -c "sleep 0.1; exec $EDITOR ~/.config/mako/config";;
    "$e")
        waypaper;;
    "$f")
        foot --app-id vimx bash -c "sleep 0.1; exec $EDITOR ~/.dotfiles/other/stuff2remember.txt";;
    "$g")
        $TERMINAL -e vimx ~/.dotfiles/nixos/hosts/zbook/configuration.nix;;
    "$h")
        $TERMINAL -e vimx ~/.dotfiles/nixos/flake.nix;;
    "$i")
        $TERMINAL -e vimx ~/.dotfiles/nixos/modules/pkgs.nix;;
    "$j")
        addnew;;
    "$k")
        fuzzel-umount
esac


#!/bin/bash

echo "##############################"
echo "#                            #"
echo "#  HOLA, VYBER SEZENÍ:       #"
echo "#                            #"
echo "#  n) NixOS Niri             #"
echo "#  r) RESTARTOVAT            #"
echo "#  x) VYPNOUT                #"
echo "#                            #"
echo "##############################"
while true; do
  read -n 1 -s wm_choice
    case $wm_choice in
    n)
    echo
    echo "Spouštím NixOS..."
    exec niri-session -l
    ;;
    x)
    echo "Vypínání..."
    exec systemctl poweroff
    sleep 1
    ;;
    r)
    echo "Restart..."
    sleep 1
    exec systemctl reboot
    ;;
    *)
    echo "Zvolte jednu z možností"
    ;;
    esac
done

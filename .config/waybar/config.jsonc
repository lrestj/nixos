[{
    "layer": "top",
    "height": 35,
    "autohide": true,
    "autohide-blocked": false,
    "margin-top": 3,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 4,
    "modules-left": [
        "niri/workspaces",
        "memory",
        "cpu",
        "temperature",
        "custom/scan",
        "custom/office",
        "custom/kalk",
        "custom/text",
        "custom/fm",
        "custom/browser"
    ],
    "modules-center": [ "wlr/taskbar" ],
    "modules-right": [
        "idle_inhibitor",
        "tray",
        "mpd",
        "pulseaudio",
        "backlight",
        "clock",
        "battery",
        "power-profiles-daemon",
        "custom/power"
    ],

    "niri/workspaces": {
            "format": "{value}",
            "format-icons": {
                "default": "",
                "active": ""
            }
    },

    "memory": {
        "format": "  Menu  RAM   {}% ",
        "on-click": "pkill fuzzel || fuzzel --config ~/.config/fuzzel/menu.ini"
    },

    "cpu": {
        "format": "CPU   {usage}%",
        "tooltip": false,
        "on-click": "pkill $TERMINAL || $TERMINAL"
    },

    "temperature": {
        "thermal-zone": 0,
        "critical-threshold": 80,
        "format": " {icon} {temperatureC} °C  ",
        "format-icons": ["", "", ""],
        "on-click": "pkill btop || $TERMINAL --app-id btop -e btop"
    },

   "custom/scan": {
        "format":"       ",
        "tooltip-format": "Skener",
        "on-click": "pkill simple-scan || simple-scan"
    },

    "custom/office": {
        "format":"       ",
        "tooltip-format": "LibreOffice",
        "on-click": "libreoffice",
        "on-click-right": "libreoffice --writer"
    },

    "custom/kalk": {
        "format":"       ",
        "tooltip-format": "Kalkulačka",
        "on-click": "pkill $kalk || $kalk"
    },

    "custom/text": {
        "format":"     ",
        "tooltip-format": "Textový editor",
        "on-click": "pkill geany || geany"
    },

   "custom/fm": {
        "format":"        ",
        "tooltip-format": "Soubory",
        "on-click": "pkill nemo || nemo"
    },

   "custom/browser": {
        "format":"      ",
        "tooltip-format": "Internet",
        "on-click": "$BROWSER"
    },

   "wlr/taskbar": {
       "format": "{icon}",
       "icon-size": 25,
       "tooltip": true,
       "tooltip-format": "{app_id}",
       "on-click": "activate",
       "on-click-right": "close"
   },

   "idle_inhibitor": {
       "format": "{icon}",
       "format-icons": {
           "activated": "",
           "deactivated": ""
       }
   },

   "pulseaudio": {
       "format": "󰕾 {volume}%  {format_source}",
       "format-bluetooth": "{volume}% {icon} {format_source}",
       "format-bluetooth-muted": " {icon} {format_source}",
       "format-muted": " {format_source}",
       "format-source": " {volume}%",
       "format-source-muted": "",
       "format-icons": {
           "headphone": "",
           "hands-free": "",
           "headset": "",
           "phone": "",
           "portable": "",
           "car": "",
           "default": ["", "", ""]
       },
       "on-click": "pkill pavucontrol || pavucontrol"
   },

   "backlight": {
       "format": " 󰃟  {percent}%  ",
       "format-icons": ["", "", "", "", "", "", "", "", ""],
       "on-click-right": "pkill foot || foot",
       "on-click": "pkill btop || foot -T btop -e btop"
   },

   "tray": {
       "spacing": 10
   },

   "clock": {
       "timezone": "Europe/Prague",
       "locale": "cs_CZ.UTF-8",
       "format": "  {:%H:%M }",
       "tooltip-format": "<big>{:L%e L%B %Y }</big>\n<tt><small>{calendar}</small></tt>",
       "format-alt": "{:L%A %d.%m.%Y}"
   },

   "battery": {
       "states": {
           "warning": 30,
           "critical": 15
       },
       "format": "{capacity}% {icon} ",
       "format-full": "{capacity}% {icon} ",
       "format-charging": "{capacity}% ",
       "format-plugged": "{capacity}% ",
       "format-alt": "{time} {icon}",
       "format-icons": ["", "", "", "", ""]
   },

   "power-profiles-daemon": {
       "format": "{icon}",
       "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
       "tooltip": true,
       "format-icons": {
           "default": "  ",
           "performance": "  ",
           "balanced": " ",
           "power-saver": " "
       }
   },

   "custom/power": {
       "format" : "  ",
       "tooltip-format": "",
       "on-click": "power"
   }
}]

/* END OF FILE */
